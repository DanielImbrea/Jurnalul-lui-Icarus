# === Stripe ===
# Cheile se iau din Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Price ID-uri (generate automat cu: yarn setup:stripe)
STRIPE_PRICE_BLAKE=price_xxx
STRIPE_PRICE_DURERE=price_xxx
STRIPE_PRICE_BUNDLE=price_xxx

# Secretul webhook-ului (Dashboard -> Developers -> Webhooks -> semnătura endpoint-ului)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Opțional: Shipping Rate ID din Stripe Dashboard (Product catalog -> Shipping rates)
# Dacă e setat, se folosește tariful din Stripe. Altfel, checkout-ul adaugă automat 19 RON.
# STRIPE_SHIPPING_RATE_ID=shr_xxx

# === Site ===
# URL-ul public al site-ului (fără slash la final), folosit pentru SEO, OG image și redirect Stripe
NEXT_PUBLIC_SITE_URL=https://www.jurnalulluiicarus.com

# === Cloudflare DNS (opțional — yarn setup:cloudflare) ===
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_DOMAIN=jurnalulluiicarus.com
# VERCEL_CNAME_TARGET=2e162f3564413017.vercel-dns-017.com

# === Contact ===
NEXT_PUBLIC_CONTACT_EMAIL=contact@danielimbrea.ro

# === Social ===
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@jurnalulluiicarus

# === Database (Supabase Postgres) ===
# Supabase → Settings → Database → Connection string
# Transaction pooler (6543) — pentru runtime:
DATABASE_URL="postgresql://postgres.bxjivmxxwrirwynokctc:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session/direct (5432) — pentru migrări Prisma:
DIRECT_URL="postgresql://postgres.bxjivmxxwrirwynokctc:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Aplică schema: yarn setup:supabase
# Alternativ manual: scripts/supabase-schema.sql în SQL Editor

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://bxjivmxxwrirwynokctc.supabase.co
NEXT_PUBLIC_SUPABASE_PROJECT_ID=bxjivmxxwrirwynokctc
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_STORAGE_BUCKET=uploads

# === Admin ===
# Parola pentru panoul /admin
ADMIN_PASSWORD=schimba-parola-aici
# Secret pentru sesiune (opțional — fallback la ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=un-secret-lung-si-aleatoriu

# === Storage (opțional) ===
# Prioritate: Supabase Storage → Vercel Blob → fișiere locale (dev)
# Supabase: vezi secțiunea Supabase de mai sus + scripts/supabase-storage.sql
BLOB_READ_WRITE_TOKEN=
