{
  "name": "daniel-imbrea-universul-literar",
  "version": "1.0.0",
  "private": true,
  "description": "Website oficial — Daniel Imbrea. Sub Umbrele lui Blake & Îmbrățișarea Durerii și Avantajele ei.",
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "prisma generate && next build",
    "start": "next start -p 3020",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "setup:supabase": "node scripts/setup-supabase-db.mjs",
    "setup:supabase-pooler": "node scripts/fix-supabase-pooler-url.mjs",
    "setup:stripe": "node scripts/setup-stripe-products.mjs",
    "setup:stripe-cli": "node scripts/install-stripe-cli.mjs",
    "stripe:login": "node scripts/install-stripe-cli.mjs && tools/stripe/stripe login",
    "stripe:listen": "node scripts/install-stripe-cli.mjs && tools/stripe/stripe listen --forward-to localhost:3020/api/webhook --events checkout.session.completed",
    "setup:cloudflare": "node scripts/setup-cloudflare-dns.mjs",
    "setup:check": "node scripts/check-setup.mjs",
    "setup:vercel-env": "node scripts/sync-vercel-env.mjs",
    "test:resend": "node scripts/test-resend-email.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "4.7.0",
    "@supabase/supabase-js": "^2.115.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "14.2.15",
    "prisma": "^5.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "16.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
